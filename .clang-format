#
# Formatting for the hand-written C/C++ consumer code under
# crates/libluminate/tests/c and crates/libluminate/examples. Does not apply
# to crates/libluminate/luminate.h, which is generated by cbindgen and
# regenerated rather than formatted; see CONTRIBUTING.md.
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 98
PointerAlignment: Right
BreakBeforeBraces: Allman
