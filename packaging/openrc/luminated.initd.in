#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Elizabeth Kiara Regina Ashford

# shellcheck shell=sh disable=SC2034

name="Luminate lighting daemon"
description="Luminate lighting daemon"

command="@BINDIR@/luminated"
command_user="@LUMINATE_USER@:@LUMINATE_GROUP@"
command_background="yes"
pidfile="@RUNTIME_DIR@/luminated.pid"
umask="0007"
retry="TERM/10/KILL/5"

depend() {
  need localmount
  use net
  after bootmisc
}

start_pre() {
  checkpath --directory --mode 0750 \
    --owner "@LUMINATE_USER@:@LUMINATE_GROUP@" \
    "@RUNTIME_DIR@" "@STATE_DIR@"

  if [ -n "${luminated_config:-}" ]; then
    export LUMINATED_CONFIG="${luminated_config}"
  fi
  if [ -n "${luminated_log:-}" ]; then
    export RUST_LOG="${luminated_log}"
  fi
}
