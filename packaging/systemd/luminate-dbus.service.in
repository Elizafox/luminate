[Unit]
Description=Luminate system D-Bus adapter
Documentation=man:luminate-dbus(8)
After=dbus.service luminated.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.luminate.Luminate1
User=@LUMINATE_DBUS_USER@
Group=@LUMINATE_GROUP@
ExecStart=@BINDIR@/luminate-dbus
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
SystemCallFilter=@system-service
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
