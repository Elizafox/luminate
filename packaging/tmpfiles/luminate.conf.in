# tmpfiles.d entries for packaged Luminate installs.

d @CONFIG_DIR@ 0755 root root -
d @STATE_DIR@ 0750 @LUMINATE_USER@ @LUMINATE_GROUP@ -
d @RUNTIME_DIR@ 0750 @LUMINATE_USER@ @LUMINATE_GROUP@ -
